.75)) )))(pin passive line (at 12.7 1.27 180) (length 2.54) (name "S+" (effects (font (size 0.8 0.8)) )) (number "3" (effects (font (size 0.75 0.75)) )))(pin passive line (at 12.7 -1.27 180) (length 2.54) (name "S-" (effects (font (size 0.8 0.8)) )) (number "4" (effects (font (size 0.75 0.75)) ))))))(text "Faz C / paralel MOSFET yarım köprüsü" (at 15 14 0) (effects (font (size 2.3 2.3)) (justify left top)) (uuid "a8c460a9-851d-526a-892a-0d847a1debdc"))(text "ESC-3K | 02_PHASE_C | A2 | TASARIM INCELEMESI" (at 15 23 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "9084c9c9-58b8-5275-a650-4496881c7d32"))(text "TASARIM NOTLARI / KABUL KRITERLERI" (at 300 37 0) (effects (font (size 1.25 1.25)) (justify left top)) (uuid "9af7cb2f-edce-5788-98e1-19d46043de59"))(text "1. 100 V CSD19536KTT; her anahtarda iki paralel MOSFET. Üç faz\ntoplam 12 MOSFET." (at 300 48 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "fe4b5cc2-1f08-5a71-aa34-b0181746a84e"))(text "2. Kalın hatlar güç yolunu gösterir. Her MOSFET kendi 4.7 ohm\nkapı direncine sahiptir." (at 300 58.7 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "cdedb33a-65ac-5fda-962e-fd040d250962"))(text "3. 4.7 ohm başlangıç değeridir. VGS, VDS taşması ve\naçma/kapama kaybıyla ayarlanır." (at 300 69.4 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "3a83f667-e300-5c50-a32f-8737db1d1a70"))(text "4. Kelvin sense uçları sadece sürücü ölçüm girişlerine gider.\nGüç akımı sense izi üzerinden geçirilmez." (at 300 80.10000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "e853c31c-f09c-5e2f-82d6-d0d42446c785"))(text "5. 0.5 mohm: 80 A sürekli varsayımında I²R=3.2 W üst sınır\nhesabı. Gerçek şönt RMS akımı PWM ile değişir." (at 300 90.80000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "6d84564e-3fec-5252-a03a-dcdf36ed9eac"))(text "6. PCB: paralel kollar simetrik; ortak kaynak endüktansı\nazaltılır. Tab pin2=Drain. Soğutucu izolasyonu ayrıca\ntasarlanır." (at 300 101.50000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "67f335be-a2cb-5cf0-9cc9-0862127b74f3"))(text "7. AÇIK R03: şönt pad yönü/termal. AÇIK R04: double-pulse ve\nkısa devre koruma süresi." (at 300 114.55000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "687b05e7-4ffc-59e0-9819-1f85de1d76bd"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "2cb2b846-3067-546d-95d4-f3cbfc6f72d1"))(symbol (lib_id "ESC_A2:NMOS") (at 101.6 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "73e307df-0171-5a08-9281-b70da00d818f")(property "Reference" "Q401" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) ))(property "Value" "CSD19536KTT" (at 101.6 69.66 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Package_TO_SOT_SMD:TO-263-3_TabPin2" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "MPN" "CSD19536KTT" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "Review" "Pin 2 is drain tab. Parallel pair requires symmetric routing and separate gate resistor." (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "A1_Reference" "Q9" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(pin "1" (uuid "7934b39e-5d97-51aa-8063-18c1fcfda02b"))(pin "2" (uuid "4db44a8b-0c25-5f3f-ba38-ab31355ddb14"))(pin "3" (uuid "0cfb4484-64ea-552c-804a-2bf343f8d8bd"))(instances (project "ESC_3kW_A2" (path "/18c8cc80-d961-52bf-9e4d-d416bedf6b3a/4ac1b0f7-47ef-5aab-9c8f-14dfcb77b93d" (reference "Q401") (unit 1)))))(symbol (lib_id "ESC_A2:R") (at 71.11999999999999 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "69f7abdd-40db-5465-a857-1db96241e9ab")(property "Reference" "R401" (at 71.11999999999999 71.74 0) (effects (font (size 0.95 0.95)) ))(property "Value" "4.7R gate" (at 71.11999999999999 74.74 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 71.1199999999