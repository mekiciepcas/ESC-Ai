ır." (at 300 101.50000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "67f335be-a2cb-5cf0-9cc9-0862127b74f3"))(text "7. AÇIK R03: şönt pad yönü/termal. AÇIK R04: double-pulse ve\nkısa devre koruma süresi." (at 300 114.55000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "687b05e7-4ffc-59e0-9819-1f85de1d76bd"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "a046d672-3899-554d-b6d3-fd42177eff07"))(symbol (lib_id "ESC_A2:NMOS") (at 101.6 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "7b944f99-f2fc-5c83-a441-9b0b7ca47c5e")(property "Reference" "Q301" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) ))(property "Value" "CSD19536KTT" (at 101.6 69.66 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Package_TO_SOT_SMD:TO-263-3_TabPin2" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "MPN" "CSD19536KTT" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "Review" "Pin 2 is drain tab. Parallel pair requires symmetric routing and separate gate resistor." (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "A1_Reference" "Q5" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(pin "1" (uuid "f2a09005-ddb4-565f-9b1e-9c8ef137707b"))(pin "2" (uuid "a4815dc4-0eaf-5212-be77-ba78d21f78c4"))(pin "3" (uuid "993c71aa-4c46-5576-9f97-75ddb984cd47"))(instances (project "ESC_3kW_A2" (path "/18c8cc80-d961-52bf-9e4d-d416bedf6b3a/cb5ee15f-a2f1-575e-bc38-e1e915773f65" (reference "Q301") (unit 1)))))(symbol (lib_id "ESC_A2:R") (at 71.11999999999999 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "f942e9ad-e927-5288-ae50-bb6faf37ea32")(property "Reference" "R301" (at 71.11999999999999 71.74 0) (effects (font (size 0.95 0.95)) ))(property "Value" "4.7R gate" (at 71.11999999999999 74.74 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 71.1199999999