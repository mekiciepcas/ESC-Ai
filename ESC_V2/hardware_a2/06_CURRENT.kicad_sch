s (font (size 2.3 2.3)) (justify left top)) (uuid "6cadb5de-64a9-5511-a6fd-23303f2f0888"))(text "ESC-3K | 06_CURRENT | A2 | TASARIM INCELEMESI" (at 15 23 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "ab984c14-3aab-5084-a9ef-71609eed5d09"))(text "TASARIM NOTLARI / KABUL KRITERLERI" (at 300 37 0) (effects (font (size 1.25 1.25)) (justify left top)) (uuid "9af7cb2f-edce-5788-98e1-19d46043de59"))(text "1. SOA/SOB/SOC → 100 ohm / 1 nF → ADC. Filtre köşe frekansı\nyaklaşık 1.59 MHz." (at 300 48 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "fb9d6152-6752-598e-b9f3-ba0a7a69d6ff"))(text "2. 0.5 mohm ve CSA gain10: nominal 5 mV/A. Sıfır nominal 1.65\nV." (at 300 58.7 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "a8986d7b-fca4-58de-971f-e2f4522ba497"))(text "3. Yazılım ilk aşama limiti düşük akımdan yükseltilir; hedef\nanlık faz limiti 120 A." (at 300 69.4 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "3afe30fe-152d-56a2-b5ca-3f5c9f02b6d6"))(text "4. ADC: üç şönt düşük taraf ölçümü. Geçerli pencere, minimum\ndarbe ve yeniden kurma algoritması gerektirir." (at 300 80.10000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "735379eb-f379-565f-9dea-5fb97b5dab63"))(text "5. Üç ADC kanalının eş zamanlı ölçüldüğü varsayılmaz.\nADC1/ADC2 planı ayrıca derlenerek doğrulanacak." (at 300 90.80000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "e67800f4-2138-5d88-832d-a859da425d1d"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "08916b9b-e5c8-53e8-a033-2cd05f2740ff"))(symbol (lib_id "ESC_A2:R") (at 78.74 54.61 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "f5dca09b-5509-5d8e-a632-58ccf32cebdc")(property "Reference" "R1101" (at 78.74 45.07 0) (effects (font (size 0.95 0.95)) ))(property "Value" "100R ADC" (at 78.74 48.07 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 78.74 45.07 0) (effects (font