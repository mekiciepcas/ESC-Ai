ır." (at 300 101.50000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "67f335be-a2cb-5cf0-9cc9-0862127b74f3"))(text "7. AÇIK R03: şönt pad yönü/termal. AÇIK R04: double-pulse ve\nkısa devre koruma süresi." (at 300 114.55000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "687b05e7-4ffc-59e0-9819-1f85de1d76bd"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "94a982d4-1f9f-5931-9007-2d4aa96b821e"))(symbol (lib_id "ESC_A2:NMOS") (at 101.6 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "a5241f00-3a4f-57e2-bd88-c4c17406aed6")(property "Reference" "Q201" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) ))(property "Value" "CSD19536KTT" (at 101.6 69.66 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Package_TO_SOT_SMD:TO-263-3_TabPin2" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "MPN" "CSD19536KTT" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "Review" "Pin 2 is drain tab. Parallel pair requires symmetric routing and separate gate resistor." (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "A1_Reference" "Q1" (at 101.6 66.66 0) (effects (font (size 0.95 0.95)) (hide yes)))(pin "1" (uuid "ef167724-f1d4-50dc-b49b-0f1f6e2ba5e6"))(pin "2" (uuid "27443f7e-0762-5918-bb75-99bf209afc1c"))(pin "3" (uuid "6a9fd04a-cfe8-5c36-87ca-6f571db61d02"))(instances (project "ESC_3kW_A2" (path "/18c8cc80-d961-52bf-9e4d-d416bedf6b3a/fc337b66-7ef1-554d-bd04-c82882ab814d" (reference "Q201") (unit 1)))))(symbol (lib_id "ESC_A2:R") (at 71.11999999999999 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "9e6be95c-523b-5704-a18f-ad0c56ff9304")(property "Reference" "R201" (at 71.11999999999999 71.74 0) (effects (font (size 0.95 0.95)) ))(property "Value" "4.7R gate" (at 71.11999999999999 74.74 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 71.1199999999