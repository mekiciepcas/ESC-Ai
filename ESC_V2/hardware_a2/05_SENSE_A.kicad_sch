. Kelepçe kaçağı ve 3V3A geri\nbeslemesi hata bütçesine dahildir." (at 300 77.75 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "ae2d669b-33ea-5c3a-8eb6-ee28d0f22e01"))(text "5. ADC acquisition süresi ve PWM ile örnekleme anı firmware\nsözleşmesinde belirlenir." (at 300 88.45 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "9cd3bd4f-9db3-558e-abac-22ca6d23b692"))(text "6. Bu bölücü 80 V sürekli sistem izni vermez; güç katının\ngeçici rejim marjı ayrıca doğrulanır." (at 300 99.15 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "0ca60ae4-7373-5acb-96d4-0a3f6e7c9acc"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "493caa3e-93bb-5aac-b679-e05512404174"))(symbol (lib_id "ESC_A2:R") (at 63.5 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "1bc3940f-f1db-5a7f-981e-1a8dabaaf49d")(property "Reference" "R801" (at 63.5 71.74 0) (effects (font (size 0.95 0.95)) ))(property "Value" "49.9k 0.1%" (at 63.5 74.74 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 63.5 71.74 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "MPN" "RT0805BRD0749K9L" (at 63.5 71.74 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "Review" " YAGEO series-code selection; verify individual MPN orderability before procurement." (at 63.5 71.74 0) (effects (font (size 0.95 0.95)) (hide yes)))(property "A1_Reference" "R46" (at 63.5 71.74 0) (effects (font (size 0.95 0.95)) (hide yes)))(pin "1" (uuid "bbac56bc-f438-53ed-ac17-daeabc3f771e"))(pin "2" (uuid "3397b581-d66e-59f1-be73-2adc28414d8b"))(instances (project "ESC_3kW_A2" (path "/18c8cc80-d961-52bf-9e4d-d416bedf6b3a/e94602db-c600-5b94-b080-a13f06b7a10f" (reference "R801") (unit 1)))))(symbol (lib_id "ESC_A2:R") (at 101.6 81.28 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "b08c0b88-8f2a-5d5c-a8b2-18c96a9cade0")(property "Reference" "R802" (at 101.6 71.74 0) (effects (font (size 0.95 0.95)) ))(proper