(version 1)
# Project engineering targets, NOT a declaration of IPC/IEC certification.
# High-current paths require a separate thermal/current-density review.
(rule "ESC general fabrication"
  (constraint clearance (min 0.20mm))
  (constraint track_width (min 0.20mm))
  (constraint edge_clearance (min 0.50mm))
  (constraint annular_width (min 0.15mm)))
(rule "ESC readable silkscreen"
  (condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
  (constraint text_height (min 1.00mm))
  (constraint text_thickness (min 0.15mm))
  (constraint silk_clearance (min 0.15mm)))
(rule "ESC standard signal vias"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.60mm))
  (constraint hole_size (min 0.30mm)))
# Do not suppress package escape conflicts: review them individually.
(rule "ESC switching potential separation"
  (condition "A.NetName == 'VBUS' || B.NetName == 'VBUS' || A.NetName == 'PH_A' || B.NetName == 'PH_A' || A.NetName == 'PH_B' || B.NetName == 'PH_B' || A.NetName == 'PH_C' || B.NetName == 'PH_C'")
  (constraint clearance (min 1.00mm)))
