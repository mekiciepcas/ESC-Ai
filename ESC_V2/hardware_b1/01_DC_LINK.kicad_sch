t top)) (uuid "6820736c-85ff-54f4-8d8a-3cd066fb36e2"))(text "ESC-3K | 01_DC_LINK | B1 | TASARIM INCELEMESI" (at 15 23 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "d8b6790c-785b-5b92-a90a-a85de9e202b9"))(text "TASARIM NOTLARI / KABUL KRITERLERI" (at 300 37 0) (effects (font (size 1.25 1.25)) (justify left top)) (uuid "21996ad6-e4bd-5432-a9a5-c97a51ceb856"))(text "1. HEDEF: 39–54.6 V çalışma; 3 kW mil gücü. 44 V altında güç\nazaltılır." (at 300 48 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "3961bb30-88b7-5d02-af8a-327ace1f16f3"))(text "2. Giriş, sigorta + ön şarj + kutup doğrulama düzeneğinden\ngelir. Doğrudan batarya bağlantısı için yayımlanmadı." (at 300 58.7 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "acdd158d-563c-5b71-aff5-7c3ccb036e81"))(text "3. 3 x 470 uF = 1410 uF. 54.6 V üzerinde depolanan enerji\nyaklaşık 2.10 J." (at 300 69.4 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "f5d5d309-fa94-547c-b3ed-8615e2e729ff"))(text "4. 100 kohm boşaltma: tau=141 s; 54.6 V → 5 V yaklaşık 337 s.\nGerilim ölçülmeden servis yapılmaz." (at 300 80.10000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "2c502f95-d3e1-5eec-b10d-e330f5901607"))(text "5. Her yarım köprüye 2.2 uF yerel seramik; DC bias ve RMS\nripple kontrol edilecek." (at 300 90.80000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "05896d31-dfd9-50f5-8cbf-cd2d4ed2d098"))(text "6. AÇIK R01: giriş modülü. AÇIK R02: geri sürülme / fren\nenerjisi. PWM kapatmak DC barayı kelepçelemez." (at 300 101.50000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "47d1cdad-3eb3-5dee-a619-12de168d23d5"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "b0907e6b-b420-5fcb-ae54-d9d26965e068"))(symbol (lib_id "ESC_B1:CONN2") (at 78.74 57.15 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "f5789fce-fd01-5093-abb2-ef42aa89df99")(property "Reference" "J101" (at 78.74 45.07 