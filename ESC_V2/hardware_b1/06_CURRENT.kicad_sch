s (font (size 2.3 2.3)) (justify left top)) (uuid "0bf64b4b-e4d3-52ec-88e8-3699afb9cec2"))(text "ESC-3K | 06_CURRENT | B1 | TASARIM INCELEMESI" (at 15 23 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "be0fab19-c30b-5469-9b3a-d7c3ce39767f"))(text "TASARIM NOTLARI / KABUL KRITERLERI" (at 300 37 0) (effects (font (size 1.25 1.25)) (justify left top)) (uuid "21996ad6-e4bd-5432-a9a5-c97a51ceb856"))(text "1. SOA/SOB/SOC → 100 ohm / 1 nF → ADC. Filtre köşe frekansı\nyaklaşık 1.59 MHz." (at 300 48 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "981303f0-27f4-551d-879d-8fc1b60b1f61"))(text "2. 0.5 mohm ve CSA gain10: nominal 5 mV/A. Sıfır nominal 1.65\nV." (at 300 58.7 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "c2ffa543-ee97-55ea-a126-bbda04a5e1c7"))(text "3. Yazılım ilk aşama limiti düşük akımdan yükseltilir; hedef\nanlık faz limiti 120 A." (at 300 69.4 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "254fac27-1312-5525-871f-91d6fb14ee50"))(text "4. ADC: üç şönt düşük taraf ölçümü. Geçerli pencere, minimum\ndarbe ve yeniden kurma algoritması gerektirir." (at 300 80.10000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "4b46033c-8036-5f4c-813d-e0fd0b78d612"))(text "5. Üç ADC kanalının eş zamanlı ölçüldüğü varsayılmaz.\nADC1/ADC2 planı ayrıca derlenerek doğrulanacak." (at 300 90.80000000000001 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "a10110be-4c90-588b-8e8f-68a4019fab47"))(polyline (pts (xy 292 35) (xy 292 256)) (stroke (width .254) (type default)) (uuid "829e5914-26b6-56c9-aff8-fc0a2a0453d4"))(symbol (lib_id "ESC_B1:R") (at 78.74 54.61 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "8d42feb3-6a5e-5568-9fa6-6b7a36303b72")(property "Reference" "R1101" (at 78.74 45.07 0) (effects (font (size 0.95 0.95)) ))(property "Value" "100R ADC" (at 78.74 48.07 0) (effects (font (size 0.95 0.95)) ))(property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 78.74 45.07 0) (effects (font